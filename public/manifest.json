{
  "manifest_version": 3,
  "name": "Habit Flow Tracker",
  "version": "1.0.0",
  "description": "Beautiful habit tracker with streaks, weekly & monthly views",
  "permissions": ["storage"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "logo16.png",
      "48": "logo48.png",
      "128": "logo192.png"
    }
  },
  "icons": {
    "16": "logo16.png",
    "48": "logo48.png",
    "128": "logo192.png"
  }
}
